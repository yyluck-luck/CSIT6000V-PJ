# Optional provider credentials. Copy this template to the ignored .env file and fill in your own values.

# Gemini (free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Any OpenAI-compatible endpoint: NAME_BASE_URL + NAME_API_KEY (optionally NAME_MODELS=model-a,model-b)
RAYGO_BASE_URL=
RAYGO_API_KEY=

# DeepSeek's own API, if you have a key
DSV41_API_KEY=

# The model answers fall back to when a provider runs out of quota or fails
FLAGPILOT_FALLBACK_MODEL=
